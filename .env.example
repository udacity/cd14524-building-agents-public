# Copy this file to .env, in project/starter (or in the module folder you are running,
# or here at the repo root; find_dotenv() searches parent folders), and fill in your keys.
# The OpenAI key is the voc- key from the classroom's Cloud Resources panel.
OPENAI_API_KEY="voc-..."
OPENAI_BASE_URL="https://openai.vocareum.com/v1"
TAVILY_API_KEY="tvly-..."
